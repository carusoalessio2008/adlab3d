  const [selectedClientDrawer, setSelectedClientDrawer] = useState(null);
  const [pdfPreviewQuote, setPdfPreviewQuote] = useState(null);

  // Active Quote Engine State (Prusa Style)
  const [quoteForm, setQuoteForm] = useState({
    jobName: 'Progetto Stampa 3D',
    clientId: 'CLI-001',
    printTimeHours: 4.5,
    filamentWeightGrams: 180,
    layerHeight: '0.20 mm',
    selectedSpoolId: 'SPL-01',
    materialMarkupPct: 35, // %
    printerPowerWatts: 180, // W
    energyCostKwh: 0.32, // €/kWh
    energyMarkupPct: 20,
    setupTimeMins: 20,
    postProcessingTimeMins: 30,
    laborHourlyRate: 25.0, // €/h
    laborMarkupPct: 20,
    printerPurchasePrice: 1500, // €
    amortizationYears: 3,
    dailyUsageHours: 8,
    maintenanceCostPct: 15,
    additionalCosts: 5.0, // Shipping / Inserts / Packaging
    failureRiskPct: 10,
    vatPct: 22,
    applyMinOrderFee: true,
    minOrderFee: 15.0
  });

  // G-Code Drag and Drop Simulator
  const handleGCodeDrop = (e) => {
    e.preventDefault();
    const files = e.dataTransfer ? e.dataTransfer.files : e.target.files;
    if (files && files[0]) {
      const fileName = files[0].name;
      // Simulate reading OrcaSlicer / PrusaSlicer header
      const mockWeight = Math.floor(Math.random() * 250) + 40;
      const mockHours = (Math.random() * 8 + 1).toFixed(1);
      
      setQuoteForm(prev => ({
        ...prev,
        jobName: fileName.replace(/\.[^/.]+$/, ""),
        filamentWeightGrams: mockWeight,
        printTimeHours: parseFloat(mockHours)
      }));
      showToast(`G-Code/3MF caricato! Rilevati: ${mockWeight}g, ${mockHours} ore di stampa.`, 'info');
    }
  };

  // PRUSA PRICING CALCULATION LOGIC
  const quoteCalculation = useMemo(() => {
    // 1. Material
    const spool = spools.find(s => s.id === quoteForm.selectedSpoolId) || spools[0];
    const rawMaterialCost = (quoteForm.filamentWeightGrams / spool.totalGrams) * spool.pricePerSpool;
    const materialCostWithMarkup = rawMaterialCost * (1 + quoteForm.materialMarkupPct / 100);

    // 2. Electricity
    const kwhConsumed = (quoteForm.printerPowerWatts / 1000) * quoteForm.printTimeHours;
    const rawEnergyCost = kwhConsumed * quoteForm.energyCostKwh;
    const energyCostWithMarkup = rawEnergyCost * (1 + quoteForm.energyMarkupPct / 100);

    // 3. Labor
    const totalLaborHours = (quoteForm.setupTimeMins + quoteForm.postProcessingTimeMins) / 60;
    const rawLaborCost = totalLaborHours * quoteForm.laborHourlyRate;
    const laborCostWithMarkup = rawLaborCost * (1 + quoteForm.laborMarkupPct / 100);

    // 4. Machine Depreciation & Wear
    // Hourly rate = Price / (Years * 365 * HoursPerDay)
    const totalLifetimeHours = quoteForm.amortizationYears * 365 * quoteForm.dailyUsageHours;
    const hourlyDepreciation = quoteForm.printerPurchasePrice / (totalLifetimeHours || 1);
    const hourlyWear = hourlyDepreciation * (quoteForm.maintenanceCostPct / 100);
    const totalMachineHourlyCost = hourlyDepreciation + hourlyWear;
    const machineDepreciationCost = totalMachineHourlyCost * quoteForm.printTimeHours;

    // 5. Subtotal before Risk & Extras
    const baseSubtotal = materialCostWithMarkup + energyCostWithMarkup + laborCostWithMarkup + machineDepreciationCost + quoteForm.additionalCosts;
    const failureBuffer = baseSubtotal * (quoteForm.failureRiskPct / 100);
    
    let calculatedNetTotal = baseSubtotal + failureBuffer;

    // Apply minimum fee if enabled
    if (quoteForm.applyMinOrderFee && calculatedNetTotal < quoteForm.minOrderFee) {
      calculatedNetTotal = quoteForm.minOrderFee;
    }

    const vatAmount = calculatedNetTotal * (quoteForm.vatPct / 100);
    const finalGrossTotal = calculatedNetTotal + vatAmount;

    return {
      spoolUsed: spool,
      rawMaterialCost,
      materialCostWithMarkup,
      kwhConsumed,
      rawEnergyCost,
      energyCostWithMarkup,
      totalLaborHours,
      rawLaborCost,
      laborCostWithMarkup,
      machineDepreciationCost,
      failureBuffer,
      calculatedNetTotal,
      vatAmount,
      finalGrossTotal,
      marginEstimated: (calculatedNetTotal - (rawMaterialCost + rawEnergyCost + rawLaborCost + machineDepreciationCost))
    };
  }, [quoteForm, spools]);

  // Convert Quote into Active Order
  const convertQuoteToOrder = () => {
