function NavItem({ id, icon, label, badge, count, highlight, activeTab, setActiveTab, darkMode }) {
  const active = activeTab === id;
  return (
    <button
      onClick={() => setActiveTab(id)}
      className={`w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-xs font-medium transition-all duration-150 ${
        active
          ? 'bg-gradient-to-r from-sky-500/20 to-indigo-500/20 text-sky-400 border border-sky-500/30 shadow-sm'
          : darkMode
          ? 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60'
          : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'
      } ${highlight ? 'border border-amber-500/40 bg-amber-500/10 text-amber-300' : ''}`}
    >
      <div className="flex items-center gap-3">
        {React.cloneElement(icon, { className: `w-4 h-4 ${active ? 'text-sky-400' : 'text-slate-400'}` })}
        <span>{label}</span>
      </div>
      {badge && (
        <span className="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-sky-500/20 text-sky-300 border border-sky-500/30">
          {badge}
        </span>
      )}
      {count !== undefined && count !== null && (
        <span className="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700">
          {count}
        </span>
      )}
    </button>
  );
}

