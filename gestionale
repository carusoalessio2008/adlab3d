    const newOrd = {
      id: `ORD-2026-${Math.floor(100 + Math.random() * 900)}`,
      customerId: client.id,
      customerName: client.name,
      title: quoteForm.jobName,
      status: 'In attesa',
      priority: 'Media',
      printerId: 'PRN-03',
      progress: 0,
      price: parseFloat(quoteCalculation.finalGrossTotal.toFixed(2)),
      dueDate: new Date(Date.now() + 5 * 86400000).toISOString().split('T')[0],
      stlName: `${quoteForm.jobName.replace(/\s+/g, '_')}.3mf`,
      weight: quoteForm.filamentWeightGrams,
      printTimeHours: quoteForm.printTimeHours
    };

    setOrders([newOrd, ...orders]);
    setQuoteModalOpen(false);
    setActiveTab('orders');
    showToast(`Preventivo convertito con successo nell'ordine ${newOrd.id}!`, 'success');
  };

  return (
