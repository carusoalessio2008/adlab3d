        </div>
      )}

      {/* GLOBAL WRAPPER */}
      <div className="flex h-screen overflow-hidden">
        
        {/* SIDEBAR NAVIGATION */}
        <aside className={`w-64 flex-shrink-0 border-r flex flex-col transition-colors duration-200 ${darkMode ? 'bg-slate-900 border-slate-800' : 'bg-white border-slate-200'}`}>
          {/* BRANDING */}
          <div className="p-5 border-b border-slate-800/50 flex items-center justify-between">
            <div className="flex items-center gap-3">
              <div className="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 via-indigo-500 to-purple-600 flex items-center justify-center text-white font-black text-xl shadow-lg shadow-indigo-500/20">
                3D
              </div>
              <div>
                <h1 className="font-extrabold tracking-tight text-lg bg-gradient-to-r from-sky-400 to-indigo-400 bg-clip-text text-transparent">
                  AdLab3D
                </h1>
                <p className="text-[10px] uppercase font-semibold text-slate-400 tracking-wider">Enterprise ERP</p>
              </div>
            </div>
          </div>

          {/* SYSTEM STATUS BADGE */}
          <div className="px-4 py-3 border-b border-slate-800/40 bg-slate-950/40 flex items-center justify-between">
            <div className="flex items-center gap-2">
              <span className="relative flex h-2.5 w-2.5">
                <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span className="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
              </span>
              <span className="text-xs font-medium text-slate-400">Database Sync</span>
            </div>
            <span className="text-[10px] bg-slate-800 text-sky-400 font-mono px-2 py-0.5 rounded border border-slate-700">
              v2.4 Live
            </span>
          </div>

          {/* NAVIGATION LINKS */}
          <nav className="flex-1 overflow-y-auto px-3 py-4 space-y-1">
            <NavItem id="dashboard" icon={<LayoutDashboard />} label="Dashboard" badge="Vista ERP" activeTab={activeTab} setActiveTab={setActiveTab} darkMode={darkMode} />
            <NavItem id="clients" icon={<Users />} label="Clienti (CRM)" count={clients.length} activeTab={activeTab} setActiveTab={setActiveTab} darkMode={darkMode} />
            <NavItem id="orders" icon={<ShoppingBag />} label="Ordini Produzione" count={orders.filter(o => o.status !== 'Consegnato').length} activeTab={activeTab} setActiveTab={setActiveTab} darkMode={darkMode} />
            <NavItem id="printers" icon={<Printer />} label="Stampe 3D & Fleet" badge={`${printers.filter(p => p.status === 'In stampa').length} in corso`} activeTab={activeTab} setActiveTab={setActiveTab} darkMode={darkMode} />
