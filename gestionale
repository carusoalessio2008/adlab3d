function AccountingView({ transactions, setTransactions, darkMode, showToast }) {
  const totalIn = transactions.filter(t => t.type === 'Entrata').reduce((acc, t) => acc + t.amount, 0);
  const totalOut = transactions.filter(t => t.type === 'Uscita').reduce((acc, t) => acc + t.amount, 0);
  const netMargin = totalIn - totalOut;

  return (
    <div className="space-y-6">
      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div className={`p-5 rounded-2xl border ${darkMode ? 'bg-slate-900/80 border-slate-800' : 'bg-white'}`}>
          <span className="text-xs text-slate-400 font-semibold">Totale Entrate</span>
          <h3 className="text-2xl font-black text-emerald-400 font-mono mt-1">€ {totalIn.toFixed(2)}</h3>
        </div>
        <div className={`p-5 rounded-2xl border ${darkMode ? 'bg-slate-900/80 border-slate-800' : 'bg-white'}`}>
          <span className="text-xs text-slate-400 font-semibold">Totale Uscite / Costi</span>
          <h3 className="text-2xl font-black text-red-400 font-mono mt-1">€ {totalOut.toFixed(2)}</h3>
        </div>
        <div className={`p-5 rounded-2xl border ${darkMode ? 'bg-slate-900/80 border-slate-800' : 'bg-white'}`}>
          <span className="text-xs text-slate-400 font-semibold">Utile Netto Gestionale</span>
          <h3 className="text-2xl font-black text-sky-400 font-mono mt-1">€ {netMargin.toFixed(2)}</h3>
        </div>
      </div>

      <div className={`rounded-2xl border overflow-hidden ${darkMode ? 'bg-slate-900/80 border-slate-800' : 'bg-white'}`}>
        <div className="p-4 border-b border-slate-800 font-bold text-xs text-white">Registro Movimenti Cassa & Fatture</div>
        <table className="w-full text-left text-xs">
          <thead className="bg-slate-950/60 text-slate-400 font-semibold">
            <tr>
              <th className="p-3.5">ID / Data</th>
              <th className="p-3.5">Tipo</th>
              <th className="p-3.5">Descrizione</th>
              <th className="p-3.5 text-right">Importo</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-slate-800/50">
            {transactions.map(t => (
              <tr key={t.id} className="hover:bg-slate-800/40">
                <td className="p-3.5 font-mono text-slate-400">{t.id} · {t.date}</td>
                <td className="p-3.5">
                  <span className={`px-2 py-0.5 rounded text-[10px] font-bold ${t.type === 'Entrata' ? 'bg-emerald-500/20 text-emerald-400' : 'bg-red-500/20 text-red-400'}`}>
                    {t.type}
                  </span>
                </td>
                <td className="p-3.5 font-medium text-slate-200">{t.description}</td>
                <td className={`p-3.5 text-right font-bold font-mono ${t.type === 'Entrata' ? 'text-emerald-400' : 'text-red-400'}`}>
                  {t.type === 'Entrata' ? '+' : '-'} € {t.amount.toFixed(2)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
