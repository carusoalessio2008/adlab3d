function InventoryView({ spools, setSpools, darkMode, showToast }) {
  const adjustStock = (spoolId, delta) => {
    setSpools(spools.map(s => {
      if (s.id === spoolId) {
        const newGrams = Math.max(0, s.remainingGrams + delta);
        return { ...s, remainingGrams: newGrams };
      }
      return s;
    }));
    showToast('Quantità spola aggiornata!', 'info');
  };

  return (
    <div className="space-y-6">
